---
#
# {{ ansible_managed }}
#
# {{ borgmatic_backup_global_hooks_file }}
#

{% if ((backup.after_everything is defined) and (backup.after_everything is not none)) or ((backup.before_everything is defined) and (backup.before_everything is not none)) %}
commands:
{% if (backup.after_everything is defined) and (backup.after_everything is not none) %}
  - after: everything
    run:
{% for command in backup.after_everything %}
      - {{ command }}
{% endfor %}
{% endif %}
{% if (backup.before_everything is defined) and (backup.before_everything is not none) %}
  - before: everything
    run:
{% for command in backup.before_everything %}
      - {{ command }}
{% endfor %}
{% endif %}
{% endif %}

repositories: []
