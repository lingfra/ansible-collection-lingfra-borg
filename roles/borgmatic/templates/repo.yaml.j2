---
# ##############################################################################
#
# {{ ansible_managed }}
#
# {{ borgmatic_repo_config_path }}
#
# See following resources for more information on borgmatic and borg:
#
#   - https://torsion.org/borgmatic/
#   - https://borgbackup.readthedocs.io/en/stable/
#
# ##############################################################################

<<: !include 
{% for file in borgmatic_repo_includes %}
  - "{{ file }}"
{% endfor %}

source_directories:
{% for source_directory in borgmatic_repo_source_directories %}
  - {{ source_directory }}
{% endfor %}

repositories:
  - path: {{ borgmatic_repo_full_path }}
    label: {{ borgmatic_repo_label }}

encryption_passcommand: cat {{ borgmatic_backup_passphrase_file }}
{% if borgmatic_repo_removable %}

before_actions:
  - {{ borgmatic_check_repo_availability_script_path }} "{repository}" "cat '{{ borgmatic_backup_passphrase_file }}'"
{% endif %}
{% set databases_configs = backup | ansible.builtin.dict2items | selectattr('key', 'ansible.builtin.search', 'databases') %}
{% for dbms in databases_configs %}

{{ dbms.key }}:
{% for db in dbms.value %}
  - {% for k, v in db.items() %}
{{ '' if loop.first else '    ' }}{{ k ~ ': ' ~ v }}
{% endfor %}
{% endfor %}
{% endfor %}
{% if backup.skip_actions | default(false) %}

skip_actions:
{% for action in backup.skip_actions %}
  - {{ action }}
{% endfor %}
{% endif %}
{% set keep_configs = backup | ansible.builtin.dict2items | selectattr('key', 'ansible.builtin.search', 'keep_') %}
{% for keep_x in keep_configs %}

{{ keep_x.key }}: {{ keep_x.value }}
{% endfor %}
